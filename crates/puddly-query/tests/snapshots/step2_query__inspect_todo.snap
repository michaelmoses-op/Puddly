---
source: crates/puddly-query/tests/step2_query.rs
expression: render_json(&r)
---
{
  "ok": true,
  "target": {
    "resource": "todo"
  },
  "resource": {
    "name": "todo",
    "exportName": "Todo",
    "path": "features/todos/todo.resource.ts",
    "fields": [
      {
        "name": "id",
        "kind": "id"
      },
      {
        "name": "title",
        "kind": "text",
        "max": 200
      },
      {
        "name": "done",
        "kind": "bool",
        "default": false,
        "filterable": true
      },
      {
        "name": "dueDate",
        "kind": "date",
        "optional": true,
        "filterable": true,
        "sortable": true
      },
      {
        "name": "project",
        "kind": "ref",
        "target": "project"
      },
      {
        "name": "owner",
        "kind": "ref",
        "target": "user"
      },
      {
        "name": "createdAt",
        "kind": "timestamp",
        "sortable": true,
        "auto": true
      },
      {
        "name": "isOverdue",
        "kind": "computed",
        "computed": {
          "opaque": true,
          "sourceShape": "(() => /* computed */)"
        }
      }
    ],
    "constraints": [
      {
        "kind": "limit",
        "per": "owner",
        "whereFields": [
          {
            "field": "done",
            "value": false
          }
        ],
        "max": 10
      }
    ],
    "access": [
      {
        "name": "create",
        "rule": {
          "kind": "authenticated"
        }
      },
      {
        "name": "delete",
        "rule": {
          "kind": "owner",
          "field": "owner"
        }
      },
      {
        "name": "list",
        "rule": {
          "kind": "owner",
          "field": "owner"
        }
      },
      {
        "name": "update",
        "rule": {
          "kind": "owner",
          "field": "owner"
        }
      }
    ],
    "actions": [
      {
        "name": "archive",
        "run": "./archive.action.ts",
        "input": [
          {
            "name": "id",
            "kind": "id"
          }
        ],
        "access": {
          "kind": "owner",
          "field": "owner"
        }
      }
    ],
    "refs": [
      "project",
      "user"
    ],
    "referencedBy": []
  }
}
